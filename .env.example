# Copy to .env and adjust (Docker Compose loads .env automatically for variable substitution).
# cp .env.example .env

# Grafana (change before exposing to the internet)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Published host ports (change if you already use these ports locally)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
NODE_EXPORTER_PORT=9100
PROMTAIL_METRICS_PORT=9080
